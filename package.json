{
  "name": "cascade",
  "productName": "Cascade",
  "version": "1.3.0",
  "description": "Cascade - local video & audio player",
  "main": "main.js",
  "author": "Falah Parkar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.falah.cascade.windows",
    "productName": "Cascade",
    "copyright": "Cascade",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "src/**/*", "build/icon.png"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "Cascade-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cascade",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      { "ext": ["mp4", "mkv", "avi", "mov", "wmv", "flv", "webm", "m4v", "mpg", "mpeg", "ts", "m2ts", "3gp", "ogv"], "name": "Video file", "role": "Viewer" },
      { "ext": ["mp3", "m4a", "aac", "flac", "wav", "ogg", "opus", "wma"], "name": "Audio file", "role": "Viewer" }
    ]
  }
}
